# Copy this file to ".env" (same folder) and fill in your values.

# Product name shown in the system prompt, API title and startup log.
# Keep this in sync with extension/brand.config.json ("productName") so both sides match.
PRODUCT_NAME=Orbit PixieBrix

# Set to true to test the whole extension WITHOUT a Copilot connection (returns canned answers)
MOCK_MODE=false

# Max characters of page/selection text sent to the agent
MAX_CONTEXT_CHARS=30000

# ---- Copilot Studio / Direct Line (powers every AI action: Summarize, Translate, Explain,
# Extract, Extract IDs, Person/Company Info, Ask AI, and OCR) --------------------------------
# Set ONE of the two options below - the backend tries COPILOT_TOKEN_ENDPOINT first, then
# DIRECT_LINE_SECRET. Either way, ONLY this backend ever sees the endpoint/secret; the extension
# only ever talks to this backend over /api/ai and /api/ocr, never to Direct Line directly.

# Option A - Copilot Studio's own token endpoint (needs your environment ID, region and bot
# schema name - usually requires Power Platform admin access to look up):
# Format: https://default{env_id}.{region}.environment.api.powerplatform.com/powervirtualagents/botsbyschema/{bot_schema_name}/directline/token?api-version=2022-03-01-preview
COPILOT_TOKEN_ENDPOINT=

# Option B - a Direct Line channel secret instead. This is usually easier to get hold of: in
# Copilot Studio open your agent -> Settings -> Channels -> "Mobile app" (this is the Direct
# Line channel) -> copy one of the two "Secret keys" shown there. The backend then generates a
# fresh token from this secret itself on every session - no external token-endpoint URL needed,
# and nothing beyond this backend process ever sees the secret.
DIRECT_LINE_SECRET=

# Direct Line regional cluster. India (default here), Europe, or the global cluster.
DIRECT_LINE_BASE_URL=https://india.directline.botframework.com

# How long to poll for a Copilot reply before giving up, and how often to poll.
COPILOT_RESPONSE_TIMEOUT_MS=30000
COPILOT_POLL_INTERVAL_MS=500

# Set to false only if your Copilot Studio agent has no OCR-capable tool configured yet -
# the backend then returns a clear error instead of uploading images it can't act on.
COPILOT_OCR_CAPABILITY_CONFIGURED=true

# Server
HOST=127.0.0.1
PORT=8000

# ---- E-mail for the Escalate (action) button -------------------------------------------------
# Leave SMTP_HOST empty to run without sending (with MOCK_MODE=true the button works in demo mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAX_EMAILS_PER_HOUR=30
MAX_EMAILS_PER_RECIPIENT_HOUR=5
