{
  "name": "orbit-pixiebrix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TP.ai Assist backend (Node.js/TypeScript) - Copilot Studio Direct Line AI router, email, weather, history.",
  "type": "commonjs",
  "scripts": {
    "dev": "node --use-system-ca --watch --require tsx/cjs src/index.ts",
    "start": "node --use-system-ca --require tsx/cjs src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true
  }
}
